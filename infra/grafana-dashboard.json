      "title": "Jobs by Queue and Status",
      "type": "barchart",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT\n  queue,\n  COUNT(*) FILTER (WHERE status = 'queued')    AS queued,\n  COUNT(*) FILTER (WHERE status = 'active')    AS active,\n  COUNT(*) FILTER (WHERE status = 'scheduled') AS scheduled,\n  COUNT(*) FILTER (WHERE status = 'waiting')   AS waiting,\n  COUNT(*) FILTER (WHERE status = 'complete')  AS complete,\n  COUNT(*) FILTER (WHERE status = 'failed')    AS failed,\n  COUNT(*) FILTER (WHERE status = 'aborted')   AS aborted\nFROM _pgwerk_jobs\nWHERE $__timeFilter(enqueued_at)\n  AND queue IN ($queue)\nGROUP BY queue\nORDER BY queue",
          "format": "table",
          "refId": "A"
        }
      ]
