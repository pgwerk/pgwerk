          },
          "rawSql": "SELECT\n  w.name,\n  w.queue,\n  w.status,\n  w.role,\n  ROUND(EXTRACT(EPOCH FROM (NOW() - w.heartbeat_at))::numeric, 1) AS heartbeat_lag_s,\n  ROUND(EXTRACT(EPOCH FROM (w.expires_at - NOW()))::numeric, 1)  AS expires_in_s,\n  COUNT(wj.job_id)                                               AS claimed_jobs\nFROM _pgwerk_worker w\nLEFT JOIN _pgwerk_worker_jobs wj ON w.id = wj.worker_id\nGROUP BY w.id, w.name, w.queue, w.status, w.role, w.heartbeat_at, w.expires_at\nORDER BY heartbeat_lag_s DESC",
          "format": "table",
          "refId": "A"
