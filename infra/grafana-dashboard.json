            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT\n  time_bucket('$__interval', started_at) AS time,\n  queue,\n  PERCENTILE_CONT(0.5)  WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (started_at - enqueued_at))) AS p50_wait,\n  PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (started_at - enqueued_at))) AS p95_wait\nFROM _pgwerk_jobs\nWHERE\n  started_at IS NOT NULL\n  AND $__timeFilter(started_at)\n  AND queue IN ($queue)\nGROUP BY 1, 2\nORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
