          "rawSql": "SELECT\n  j.id,\n  j.queue,\n  j.function,\n  j.attempts,\n  j.max_attempts,\n  j.enqueued_at,\n  e.error\nFROM _pgwerk_jobs j\nLEFT JOIN LATERAL (\n  SELECT error FROM _pgwerk_jobs_executions\n  WHERE job_id = j.id\n  ORDER BY attempt DESC\n  LIMIT 1\n) e ON true\nWHERE j.status = 'failed'\n  AND $__timeFilter(j.enqueued_at)\n  AND j.queue IN ($queue)\nORDER BY j.enqueued_at DESC\nLIMIT 50",
