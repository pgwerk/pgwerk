      "title": "Schedule Health",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT\n  s.name,\n  s.function,\n  s.queue,\n  COALESCE(s.cron, s.interval_secs::text || 's') AS schedule,\n  s.paused,\n  s.last_run_at,\n  ROUND(EXTRACT(EPOCH FROM (s.next_run_at - NOW()))::numeric, 0) AS next_run_in_s,\n  COUNT(j.id) FILTER (WHERE j.status = 'complete') AS completed_runs,\n  COUNT(j.id) FILTER (WHERE j.status = 'failed')   AS failed_runs,\n  ROUND(\n    COUNT(j.id) FILTER (WHERE j.status = 'failed')::numeric /\n    NULLIF(COUNT(j.id) FILTER (WHERE j.status IN ('complete','failed')), 0),\n    4\n  ) AS failure_rate\nFROM _pgwerk_schedules s\nLEFT JOIN _pgwerk_jobs j\n  ON j.schedule_name = s.name\n  AND $__timeFilter(j.enqueued_at)\nGROUP BY s.name, s.function, s.queue, s.cron, s.interval_secs, s.paused, s.last_run_at, s.next_run_at\nORDER BY s.name",
          "format": "table",
          "refId": "A"
        }
      ]
