      "title": "Job Throughput (completed per $__interval)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT\n  time_bucket('$__interval', completed_at) AS time,\n  queue,\n  COUNT(*) AS completed\nFROM _pgwerk_jobs\nWHERE\n  status = 'complete'\n  AND $__timeFilter(completed_at)\n  AND queue IN ($queue)\nGROUP BY 1, 2\nORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
