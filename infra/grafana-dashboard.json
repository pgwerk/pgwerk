      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT\n  function,\n  queue,\n  COUNT(*) FILTER (WHERE status = 'complete') AS complete,\n  COUNT(*) FILTER (WHERE status = 'failed')   AS failed,\n  ROUND(AVG(attempts)::numeric, 2)            AS avg_attempts,\n  MAX(attempts)                               AS max_attempts_seen\nFROM _pgwerk_jobs\nWHERE $__timeFilter(enqueued_at)\n  AND queue IN ($queue)\nGROUP BY function, queue\nORDER BY failed DESC, avg_attempts DESC\nLIMIT 30",
          "format": "table",
          "refId": "A"
        }
