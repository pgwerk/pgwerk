      "title": "Job Execution Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT\n  time_bucket('$__interval', completed_at) AS time,\n  PERCENTILE_CONT(0.5)  WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (completed_at - started_at))) AS p50,\n  PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (completed_at - started_at))) AS p95,\n  PERCENTILE_CONT(0.99) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (completed_at - started_at))) AS p99\nFROM _pgwerk_jobs\nWHERE\n  status = 'complete'\n  AND started_at IS NOT NULL\n  AND completed_at IS NOT NULL\n  AND $__timeFilter(completed_at)\n  AND queue IN ($queue)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
